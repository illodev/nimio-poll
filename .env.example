# Environment Variables for Nimio Poll

# Slack App Credentials
# Get these from https://api.slack.com/apps
SLACK_CLIENT_ID=your_client_id
SLACK_CLIENT_SECRET=your_client_secret
SLACK_SIGNING_SECRET=your_signing_secret

# Bot Token (for single workspace setup)
# Not needed if using OAuth for multi-workspace
SLACK_BOT_TOKEN=xoxb-your-bot-token

# OAuth Redirect URI
# Should match what you set in Slack app settings
SLACK_REDIRECT_URI=https://your-app.vercel.app/api/slack/oauth/redirect

# Upstash Redis Storage
# Get these from https://console.upstash.com or Vercel Marketplace
UPSTASH_REDIS_REST_KV_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=your_upstash_token

# Optional: App URL
APP_URL=https://your-app.vercel.app
